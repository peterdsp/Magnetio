PORT=8080
LOG_LEVEL=info

# Redis cache (optional, uses in-memory if not set)
REDIS_URI=redis://localhost:6379

# Stream cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_STREAMS=3600

# Comma-separated provider ids to skip entirely (even if a client requests them).
# Useful for sites that are dead or blocked from this host.
# SCRAPER_DISABLED_PROVIDERS=glotorrents,kickasstorrents,1337x

# Optional outbound proxy for provider requests. Some sites answer fine from
# one network and refuse another: this host sees 403 from animetosho and 429
# from bt4g, while both return results from a different IP with identical
# requests. Off unless set.
#
# Schemes: socks5h://, socks5://, socks4://, http://, https://
# SCRAPER_PROXY_URL=socks5h://127.0.0.1:1080
#
# Which providers go through it. Default is all of them, but scoping to the
# ones that need it is usually better: a single exit for every provider adds
# one point of failure for the twenty that are already fine, and a VPN route
# is normally slower than a direct one.
# SCRAPER_PROXY_PROVIDERS=animetosho,bt4g
#
# Note: a torznab request is never proxied. It is the one provider whose URL
# comes from the user, it is SSRF-pinned for that reason, and it normally
# points at Jackett or Prowlarr on your own LAN.
