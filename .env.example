PORT=7000
LOG_LEVEL=info
CACHE_TTL_STREAMS=3600

METRICS_USER=admin
METRICS_PASSWORD=changeme

# Public URL used by the addon when generating absolute subtitle proxy links.
ADDON_PUBLIC_URL=https://your-domain.example

# Optional OpenSubtitles integration for subtitle search and syncing.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=Magnetio v1.0.0

# Optional sync tooling overrides inside the addon container.
# ffsubsync is installed in the addon image by default.
# FFSUBSYNC_PATH=ffsubsync
# ALASS_PATH=alass
SUBTITLE_SYNC_MAX_OFFSET_SECONDS=300
ALASS_SPLIT_PENALTY=10

# Optional TMDB key. The addon uses it for "More Like This" recommendations
# (users can also supply their own in the configuration page). The scraper uses
# it to look up localized titles, so an Italian request finds "Il Padrino" as
# well as "The Godfather". Without a key both features simply stay off.
TMDB_API_KEY=

# Extra search passes for non-English audio. These only run for a language a
# request actually asks for, so raising them costs nothing on English requests.
# SCRAPER_MAX_ALIAS_QUERIES=1     # passes using a localized title
# SCRAPER_MAX_TAG_QUERIES=1       # passes using a scene tag, e.g. "<name> ITA"
# SCRAPER_MAX_ALIAS_LANGUAGES=3   # how many requested languages to look up

# Optional: Jackett / Prowlarr (start with docker compose --profile jackett/prowlarr up)
# JACKETT_PORT=9117
# PROWLARR_PORT=9696
# TZ=Etc/UTC
